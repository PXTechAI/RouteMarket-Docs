{
  "name": "px06-routelab-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "next build",
    "clean": "node -e \"const fs=require('node:fs'); ['.next', '.source', 'tsconfig.tsbuildinfo'].forEach((path)=>fs.rmSync(path,{ recursive:true, force:true }))\"",
    "dev": "next dev -p 3004 -H 0.0.0.0",
    "postinstall": "fumadocs-mdx",
    "prebuild": "corepack pnpm run clean",
    "pretypecheck": "fumadocs-mdx",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental false"
  },
  "dependencies": {
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "13.0.8",
    "fumadocs-ui": "15.8.5",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@tailwindcss/postcss": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
